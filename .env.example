# Demo defaults – nothing is sent, nothing is tracked, every page is noindex.
VITE_BASE_PATH=/tojoko-demo/
SITE_URL=https://samijturunen01.github.io/tojoko-demo/
VITE_FORM_MODE=demo
VITE_ALLOW_INDEXING=false

# Production (only after customer approval):
# VITE_BASE_PATH=/
# SITE_URL=https://<customer-domain>/
# VITE_FORM_MODE=apps-script
# VITE_FORM_ENDPOINT=https://script.google.com/macros/s/<deployment-id>/exec
# VITE_RECAPTCHA_SITE_KEY=<public site key – the secret key stays in Apps Script>
# VITE_ALLOW_INDEXING=true
